{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "maxDuration": 15,
      "excludeFiles": "{data/**,deliverables/**,analysis/**,tests/**,models/models/**,models/data/**,.venv/**}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
